{
  "name": "typescript-evolve-fork",
  "version": "1.0.0",
  "description": "A fantasy civilization building game inspired by Evolve",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite node_modules/.cache .vitepress/dist || true",
    "clean-all": "npm run clean && rm -rf node_modules package-lock.json || true",
    "lint": "eslint . && node scripts/check-rule-severity.mjs",
    "lint:fix": "eslint . --fix && node scripts/check-rule-severity.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "keywords": [
    "game",
    "typescript",
    "civilization",
    "incremental"
  ],
  "type": "module",
  "dependencies": {
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typpi/eslint-plugin-vite": "^1.0.22",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.20.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
